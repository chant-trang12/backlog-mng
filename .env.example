# Cổng chạy ứng dụng
PORT=3001
NODE_ENV=development
NODE_TLS_REJECT_UNAUTHORIZED=0

# Loại database: 'sqlite' (mặc định cho Dev) hoặc 'mssql' (cho Production / SQL Server)
DB_CLIENT=sqlite

# ==========================================
# Cấu hình SQLite (dùng khi DB_CLIENT=sqlite)
# ==========================================
SQLITE_FILENAME=./data/backlog.db

# =============================================
# Cấu hình SQL Server (dùng khi DB_CLIENT=mssql)
# =============================================
MSSQL_SERVER=127.0.0.1
MSSQL_PORT=1433
MSSQL_USER=sa
MSSQL_PASSWORD=YourStrongPassword!
MSSQL_DATABASE=backlog_mng
# Nếu kết nối SQL Server nội bộ/tự ký chứng chỉ SSL:
MSSQL_ENCRYPT=false
MSSQL_TRUST_SERVER_CERTIFICATE=true
# Connection pool (tùy chọn)
MSSQL_POOL_MIN=2
MSSQL_POOL_MAX=10

# =============================================
# Cấu hình SSO (OpenID Connect / OAuth 2.0)
# =============================================
# Bật/tắt SSO (mặc định false cho Dev/Test cục bộ)
SSO_ENABLED=false
# URL Discovery OIDC của IdP (Keycloak, Azure AD / Microsoft Entra ID, Okta...)
# LƯU Ý: phải có trailing slash nếu IdP trả về có trailing slash ở claim "issuer"
# Ví dụ: nếu discovery trả "issuer": "https://idp.example.com/" → set đúng như vậy
OIDC_ISSUER=https://sso.company.com/realms/your-realm/
OIDC_CLIENT_ID=backlog-manager
OIDC_CLIENT_SECRET=your-client-secret
# Redirect URI sau khi IdP xác thực thành công (path hoặc URL đầy đủ).
# Nếu là path, sẽ tự resolve theo protocol + Host của request hiện tại (không cần config APP_BASE_URL).
OIDC_REDIRECT_URI=/auth/callback
# Post Logout Redirect URI của client trên IdP (path hoặc URL đầy đủ).
# Nếu là path, sẽ tự resolve theo protocol + Host của request hiện tại.
OIDC_LOGOUT_URI=/auth/logout
# Chuỗi bí mật ký Session cookie (tối thiểu 32 ký tự ngẫu nhiên)
SESSION_SECRET=change-me-to-a-random-32-char-secret-string
# Đặt true nếu chạy qua HTTPS
COOKIE_SECURE=false

# =============================================
# Vượt proxy công ty (môi trường Windows + Squid/WinHTTP)
# =============================================
# Code đã bypass proxy mặc định cho OIDC calls (dùng raw socket để vượt WinHTTP).
# Nếu IdP dùng cert tự ký, set NODE_TLS_REJECT_UNAUTHORIZED=0.
# KHÔNG cần set NO_PROXY thủ công — code tự bypass proxy cho IdP.
# Tuy nhiên nếu muốn ép code dùng proxy (vd: IdP công khai qua internet):
# OIDC_USE_HTTPS_PROXY=true
