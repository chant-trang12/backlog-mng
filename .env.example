# Cổng chạy ứng dụng
PORT=3001
NODE_ENV=development

# Loại database: 'sqlite' (mặc định cho Dev) hoặc 'mssql' (cho Production / SQL Server)
DB_CLIENT=sqlite

# ==========================================
# Cấu hình SQLite (dùng khi DB_CLIENT=sqlite)
# ==========================================
SQLITE_FILENAME=./data/backlog.db

# =============================================
# Cấu hình SQL Server (dùng khi DB_CLIENT=mssql)
# =============================================
MSSQL_SERVER=127.0.0.1
MSSQL_PORT=1433
MSSQL_USER=sa
MSSQL_PASSWORD=YourStrongPassword!
MSSQL_DATABASE=backlog_mng
# Nếu kết nối SQL Server nội bộ/tự ký chứng chỉ SSL:
MSSQL_ENCRYPT=false
MSSQL_TRUST_SERVER_CERTIFICATE=true
# Connection pool (tùy chọn)
MSSQL_POOL_MIN=2
MSSQL_POOL_MAX=10
